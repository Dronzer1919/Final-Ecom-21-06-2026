# ===================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git!

# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
MONGODB_URI=mongodb://ecomUser:password@host.docker.internal:27017/ecommerce?authSource=ecommerce

# JWT Configuration
JWT_SECRET=your_super_secure_random_jwt_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_super_secure_random_refresh_secret_key_minimum_32_characters
JWT_EXPIRE=1d
JWT_REFRESH_EXPIRE=7d

# CORS Configuration (Your frontend domains)
CORS_ORIGINS=https://app.routeretail.com,https://routeretail.com,https://www.routeretail.com

# Encryption Keys (Generate random 32-character and 16-character strings)
ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_IV=your_16_char_iv_here

# Optional: Email Configuration (if using email features)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# Optional: Redis Configuration (if using Redis for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: AWS S3 Configuration (if using file uploads)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=
