# Server Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/ecommerce

# JWT Secret Keys
JWT_SECRET=your_super_secret_jwt_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_this_in_production
JWT_EXPIRE=1d
JWT_REFRESH_EXPIRE=7d

# Encryption Keys (AES-256)
ENCRYPTION_KEY=your_32_character_encryption_key_change_this_must_be_32_chars
ENCRYPTION_IV=your_16_char_iv_change_this_must_be_16

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,http://localhost:8101
